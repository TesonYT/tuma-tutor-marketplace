# Tutor track (omit DATABASE_URL to run the old in-memory sandbox only)
DATABASE_URL=postgres://user:pass@host:5432/ethel
PGSSL=require                 # set for Supabase / Vercel Postgres
ADMIN_EMAIL=you@example.com   # admin login, seeded on start
ADMIN_PASSWORD=change-me
ADMIN_NOTIFY_EMAIL=you@example.com
NOTIFY_WEBHOOK_URL=           # optional: POST {to,subject,text} to your mail service

# Payment terms (Design Spec section 7 "TO FILL IN") - unset shows "to be confirmed"
SESSION_RATE_ZMW=
SESSION_MINUTES=
PLATFORM_SHARE_PCT=
PAYOUT_FREQUENCY=             # weekly | fortnightly | monthly
STUDENT_PAYMENT_PROVIDERS=Airtel Money, MTN MoMo
